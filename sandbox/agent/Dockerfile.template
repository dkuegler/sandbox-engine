ARG AGENT

# sandbox.sh replaces the literal $BASE_IMAGE with the resolved environment
# (functions/environment.sh): apptainer does not evaluate ARG in FROM.
FROM $BASE_IMAGE AS base

ARG USERNAME=agent
ARG UID=1000
ARG GID=1000

ENV PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

LABEL agent="${AGENT}"

# git for the agent; the read-only .git mask is the access control.
# GIT_OPTIONAL_LOCKS=0 keeps status/diff quiet on that mask;
# GIT_CONFIG_NOSYSTEM=1 ignores the image's /etc/gitconfig.
ENV GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_NOSYSTEM=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg poppler-utils imagemagick git \
    && rm -rf /var/lib/apt/lists/*

FROM base AS claude
# claude: Node.js + npm package. zsh: claude code CLI looks for a shell
# it can use for its own shell-integration/completion setup and expects
# zsh to be installed, not just bash.
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs zsh \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force \
    && ln -sf "$(command -v claude)" /usr/local/bin/claude

FROM base AS opencode
# opencode's installer, with its INSTALL_DIR moved out of $HOME
# (docs/maintenance.md). The test -x catches an install that silently wrote
# nothing: a piped installer exits 0 either way.
RUN export HOME="/usr/local" \
    && curl -fsSL https://opencode.ai/v2/install \
        | sed 's|INSTALL_DIR=\$HOME/.opencode/bin|INSTALL_DIR=/usr/local/opencode/bin|' \
        | bash \
    && test -x /usr/local/opencode/bin/opencode

ENV PATH="/usr/local/opencode/bin:${PATH}"

FROM base AS omp
# omp (oh my pi): curl install script
RUN export PI_INSTALL_DIR="/usr/local/omp/bin" ; \
    curl -fsSL https://omp.sh/install.sh | sh ;

ENV PATH="/usr/local/omp/bin:${PATH}"

# omp's native addons, extracted into the image at build time; the per-run
# ~/.omp links to this read-only copy (functions/omp-home.sh). The host's
# ~/.omp/natives is never mounted: omp would load a sandbox-written addon on
# the host (docs/project-config-masking.md). `omp config path` extracts them.
RUN HOME=/tmp/omp-natives-home omp config path >/dev/null \
    && mv /tmp/omp-natives-home/.omp/natives /usr/local/omp/natives \
    && rm -rf /tmp/omp-natives-home \
    && test -n "$(find /usr/local/omp/natives -name '*.node' -print -quit)"

ARG AGENT
FROM $AGENT AS final