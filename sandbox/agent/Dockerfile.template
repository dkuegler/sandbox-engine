ARG AGENT

# Base image for the "base" stage below. sandbox.sh resolves this from
# sandbox.yml (environment.image / environment.dockerfile / environment.preset)
# and/or --environment KEY=VALUE command-line flags, and substitutes the
# literal "$BASE_IMAGE" placeholder via sed, since apptainer's Dockerfile
# bootstrap does not evaluate ARG inside FROM lines.
# The generated file is only ever consumed by "apptainer build". The
# textual placeholder substitution exists because apptainer cannot evaluate
# ARG in FROM lines.
# With no sandbox.yml/--environment (or no environment.* set), this defaults
# to the "uv" preset: ghcr.io/astral-sh/uv:python3.13-bookworm-slim (uv
# preinstalled). Environments that need uv but don't ship it (e.g. a plain
# "python" preset or a custom image/dockerfile) must provide it themselves —
# see the "latex" preset / sandbox/latex/Dockerfile for an example that
# layers uv onto a non-uv base via environment.preset (or
# environment.dockerfile, pointed at a fork of that file).
FROM $BASE_IMAGE AS base

ARG USERNAME=agent
ARG UID=1000
ARG GID=1000
# Which agent to install into this image: claude | opencode | omp

ENV PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"

LABEL agent="${AGENT}"

# git ships directly in the shared layer (decided 2026-09-17:
# option A) -- there is no MCP sidecar to bridge to, so no `nc`/transport
# dependency is needed here. GIT_OPTIONAL_LOCKS=0 keeps `status`/`diff`
# from emitting confusing lock errors against the read-only `.git` mask
# (functions/git-mask.sh); GIT_CONFIG_NOSYSTEM=1 keeps the container from
# reading a host-wide /etc/gitconfig that was never meant to travel here.
ENV GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_NOSYSTEM=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg poppler-utils imagemagick git \
    && rm -rf /var/lib/apt/lists/*

FROM base AS claude
# claude: Node.js + npm package
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && npm cache clean --force \
    && ln -sf "$(command -v claude)" /usr/local/bin/claude

FROM base AS opencode
# opencode: curl install script. opencode.ai/install.sh (used until this
# comment was updated) now 404s -- the project moved its installer to
# /v2/install (opencode.ai/install redirects to a moving `dev`-branch raw
# file on GitHub, not something to pin a build to). Verified 2026-09-15:
# https://opencode.ai/v2/install returns 200 and still sets
# INSTALL_DIR=$HOME/.opencode/bin, so the same sed override applies.
# NOTE: the `&&` matters. Without it the line-continuation folds the curl
# invocation into `export`'s argument list, the pipeline reads empty
# input, the RUN layer still exits 0, and the image ships without an
# opencode binary.
RUN export HOME="/usr/local" \
    && curl -fsSL https://opencode.ai/v2/install \
        | sed 's|INSTALL_DIR=\$HOME/.opencode/bin|INSTALL_DIR=/usr/local/opencode/bin|' \
        | bash \
    && test -x /usr/local/opencode/bin/opencode

ENV PATH="/usr/local/opencode/bin:${PATH}"

FROM base AS omp
# omp (oh my pi): curl install script
RUN export PI_INSTALL_DIR="/usr/local/omp/bin" ; \
    curl -fsSL https://omp.sh/install.sh | sh ;

ENV PATH="/usr/local/omp/bin:${PATH}"

# omp's native addons, extracted once at build time into the image, so a
# run can use this read-only copy instead of the host's ~/.omp/natives:
# omp reuses an extracted addon whenever its file size matches, with no
# hash check, so a copy the sandbox could write would be native code the
# next host omp loads. `omp config path` is a cheap command that loads --
# and so extracts -- them; `omp --version` does not.
RUN HOME=/tmp/omp-natives-home omp config path >/dev/null \
    && mv /tmp/omp-natives-home/.omp/natives /usr/local/omp/natives \
    && rm -rf /tmp/omp-natives-home \
    && test -n "$(find /usr/local/omp/natives -name '*.node' -print -quit)"

ARG AGENT
FROM $AGENT AS final